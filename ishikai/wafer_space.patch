+def _find_r2r_ladders(root, width: int) -> list[dict]:
+    """Locate all passive R-2R macro instances of bit width `width` in RTL or GL hierarchy."""
+    found: list[tuple[str, dict]] = []
+
+    def walk(obj, prefix: str = "") -> None:
+        if isinstance(obj, HierarchyArrayObject):
+            for sub in obj:
+                walk(sub, prefix)
+            return
+        if not isinstance(obj, HierarchyObject):
+            return
+        name = obj._name.lstrip("\\").strip()
+        full = f"{prefix}.{name}" if prefix else name
+        if name == "u_r2r" or name.endswith(".u_r2r"):
+            children = {c._name.strip(): c for c in obj}
+            if "in" in children and "term" in children and len(children["in"]) == width:
+                found.append((full, children))
+            return
+        for sub in obj:
+            if isinstance(sub, (HierarchyObject, HierarchyArrayObject)):
+                walk(sub, full)
+
+    walk(root)
+    found.sort(key=lambda item: _xls_inst_sort_key(item[0]))
+    return [pins for _, pins in found]
+
+
+def _read_ladder_codes(ladders: list[dict]) -> list[int]:
+    codes = []
+    for pins in ladders:
+        assert int(pins["term"].value) == 0, f"Expected R-2R term=0, got {pins['term'].value}"
+        codes.append(int(pins["in"].value))
+    return codes
+
+
+def _drive_adc_pads(dut, adc_ladders: list[dict], targets: list[int]) -> None:
+    """Drive comparator output on external bb_ua_PAD[3:0] while leaving bb_ua_PAD[5:4] Hi-Z."""
+    bits = []
+    for ch in range(3, -1, -1):
+        in_val = int(adc_ladders[ch]["in"].value)
+        step = (~in_val) & 0xF
+        bits.append("1" if targets[ch] > step else "0")
+    dut.bb_ua_PAD.value = LogicArray("ZZ" + "".join(bits))
+
+
+def _read_dac_pad_msbs(dut) -> int:
+    s = str(dut.bb_ua_PAD.value)
+    return (int(s[0]) << 1) | int(s[1])
+
