+def _dac_inst_sort_key(path: str) -> tuple[int, str]:
+    m = re.search(r"call(?:__(\d+))?_inst", path)
+    if m:
+        return (int(m.group(1)) if m.group(1) else 0, path)
+    return (999, path)
