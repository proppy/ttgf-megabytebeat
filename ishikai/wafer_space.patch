+def _drive_adc_pads(dut, adc_ladders: list[dict], targets: list[int]) -> None:
+    """Drive external comparator outputs on bb_ua_PAD[3:0] without disturbing bb_ua_PAD[5:4]."""
+    for ch in range(4):
+        in_val = int(adc_ladders[ch]["in"].value)
+        step = (~in_val) & 0xF
+        dut.bb_ua_PAD[ch].value = 1 if targets[ch] > step else 0
+
+
+def _read_dac_pad_msbs(dut) -> int:
+    return (int(dut.bb_ua_PAD[5].value) << 1) | int(dut.bb_ua_PAD[4].value)
+
