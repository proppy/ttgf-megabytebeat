+def make_via2_3x3(block, tech):
+    """Create a DRC-clean GF180MCU 3x3 Via2 array using VIARULE Via2_GEN_HH."""
+    name = "gnss_bb_via2_3x3"
+    existing = block.findVia(name)
+    if existing is not None:
+        return existing
+    rule = tech.findViaGenerateRule("Via2_GEN_HH")
+    if rule is None:
+        raise SystemExit("[ERROR] VIARULE Via2_GEN_HH not found in tech LEF")
+    v = odb.dbVia_create(block, name)
+    v.setViaGenerateRule(rule)
+    params = v.getViaParams()
+    dbu = block.getDbUnitsPerMicron()
+    # 0.26 um cut, 0.36 um array spacing (V2.2b clean for 3x3), 0.12 um M2/M3 enclosure
+    # -> 1.74 x 1.74 um total metal bbox, comfortably inside 2.54 x 2.54 um M2/M3 junction.
+    params.setBottomLayer(tech.findLayer("Metal2"))
+    params.setCutLayer(tech.findLayer("Via2"))
+    params.setTopLayer(tech.findLayer("Metal3"))
+    params.setXCutSize(int(round(0.26 * dbu)))
+    params.setYCutSize(int(round(0.26 * dbu)))
+    params.setXCutSpacing(int(round(0.36 * dbu)))
+    params.setYCutSpacing(int(round(0.36 * dbu)))
+    params.setXBottomEnclosure(int(round(0.12 * dbu)))
+    params.setYBottomEnclosure(int(round(0.12 * dbu)))
+    params.setXTopEnclosure(int(round(0.12 * dbu)))
+    params.setYTopEnclosure(int(round(0.12 * dbu)))
+    params.setNumCutRows(3)
+    params.setNumCutCols(3)
+    v.setViaParams(params)
+    return v
